#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""查询/切换 KDE Plasma 的深色、浅色模式。

不在此处指定具体主题：直接使用系统设置里已配置好的全局主题配对，
通过 plasma-apply-lookandfeel --apply 应用对应主题。
输出为单行 light 或 dark。
"""

from __future__ import annotations

import argparse
import configparser
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional, Tuple

DEFAULT_LIGHT_THEME = "org.kde.breeze.desktop"
DEFAULT_DARK_THEME = "org.kde.breezedark.desktop"
FALLBACK_LIGHT_SCHEME = "Breeze"
FALLBACK_DARK_SCHEME = "BreezeDark"

# 切换后等待系统各条主题通道对齐的最长时间（秒）；可用 DARKLIGHT_SETTLE_TIMEOUT 覆盖。
DEFAULT_SETTLE_TIMEOUT = 1.6
SETTLE_POLL_INTERVAL = 0.05
# 未命中系统预设时的提示前缀。界面按这个前缀识别并弹出带按钮的系统通知，
# 前缀之后（最后一个「：」之后）是本次实际使用的主题名，改动时两处要一起改。
NOTICE_PREFIX = "darklight-toggle: 提示：未配置深浅主题预设"
NOTICE_SOURCE_LABELS = {"derived": "按名称推断", "default": "使用兜底默认"}
# 对齐后、补发通知前的静默期（秒）：应用是在收到通知的那一刻去读值的，
# 紧接着第一批通知补发，读到的往往还是旧值。可用 DARKLIGHT_NUDGE_DELAY 覆盖。
DEFAULT_NUDGE_DELAY = 0.6

# 主题名称里可能出现的明暗标记，用于判断状态和寻找配对主题。
DARK_TOKENS = ("dark", "深色", "night", "夜间")
LIGHT_TOKENS = ("light", "浅色", "day", "白天")
# 浅色 -> 深色 的替换对（含反向），按长度从长到短排列避免误替换。
SWAP_PAIRS: Tuple[Tuple[str, str], ...] = (
    ("浅色", "深色"),
    ("深色", "浅色"),
    ("LIGHT", "DARK"),
    ("DARK", "LIGHT"),
    ("Light", "Dark"),
    ("Dark", "Light"),
    ("light", "dark"),
    ("dark", "light"),
)


def config_home() -> Path:
    configured = os.environ.get("XDG_CONFIG_HOME")
    return Path(configured) if configured else Path.home() / ".config"


def data_dirs() -> list[Path]:
    dirs: list[Path] = []
    xdg_data_home = os.environ.get("XDG_DATA_HOME")
    dirs.append(Path(xdg_data_home) if xdg_data_home else Path.home() / ".local" / "share")
    for entry in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(os.pathsep):
        if entry:
            dirs.append(Path(entry))
    return dirs


def load_config(filename: str) -> configparser.ConfigParser:
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str.lower
    try:
        with (config_home() / filename).open("r", encoding="utf-8", errors="replace") as handle:
            parser.read_file(handle)
    except (OSError, configparser.Error):
        pass
    return parser


def kread(group: str, key: str, filename: str = "kdeglobals") -> str:
    for tool in ("kreadconfig6", "kreadconfig5"):
        executable = shutil.which(tool)
        if not executable:
            continue
        try:
            result = subprocess.run(
                [executable, "--file", filename, "--group", group, "--key", key],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=5,
            )
            value = result.stdout.strip()
            if value:
                return value
        except (OSError, subprocess.SubprocessError):
            continue
    return ""


def mode_from_name(name: str) -> Optional[str]:
    lowered = name.lower()
    if any(token in lowered for token in DARK_TOKENS):
        return "dark"
    if any(token in lowered for token in LIGHT_TOKENS):
        return "light"
    return None


def parse_rgb(value: str) -> Optional[Tuple[int, int, int]]:
    if not value:
        return None
    parts = [part for part in re.split(r"[,;\s]+", value.strip()) if part]
    if len(parts) < 3:
        return None
    try:
        numbers = tuple(int(round(float(part))) for part in parts[:3])
    except ValueError:
        return None
    if all(0 <= number <= 255 for number in numbers):
        return numbers  # type: ignore[return-value]
    return None


def relative_luminance(rgb: Tuple[int, int, int]) -> float:
    def channel(value: int) -> float:
        component = value / 255.0
        return component / 12.92 if component <= 0.04045 else ((component + 0.055) / 1.055) ** 2.4

    red, green, blue = rgb
    return 0.2126 * channel(red) + 0.7152 * channel(green) + 0.0722 * channel(blue)


def palette_mode(parser: configparser.ConfigParser) -> Optional[str]:
    # Colors:View 是文档背景，比 Colors:Window 更能代表明暗模式。
    for section in ("Colors:View", "Colors:Window"):
        if parser.has_section(section):
            rgb = parse_rgb(parser.get(section, "backgroundnormal", fallback=""))
            if rgb:
                return "dark" if relative_luminance(rgb) < 0.45 else "light"
    return None


def portal_mode() -> Optional[str]:
    """通过 freedesktop portal 读取当前明暗，这是应用实际看到的值。"""
    executable = shutil.which("dbus-send")
    if not executable:
        return None
    try:
        result = subprocess.run(
            [
                executable,
                "--session",
                "--print-reply=literal",
                "--dest=org.freedesktop.portal.Desktop",
                "/org/freedesktop/portal/desktop",
                "org.freedesktop.portal.Settings.ReadOne",
                "string:org.freedesktop.appearance",
                "string:color-scheme",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
        )
        numbers = re.findall(r"\d+", result.stdout)
        if numbers:
            value = int(numbers[-1])
            if value == 1:
                return "dark"
            if value == 2:
                return "light"
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def current_look_and_feel(parser: configparser.ConfigParser) -> str:
    name = kread("KDE", "LookAndFeelPackage")
    if not name and parser.has_section("KDE"):
        name = parser.get("KDE", "lookandfeelpackage", fallback="")
    return name.strip()


def current_color_scheme(parser: configparser.ConfigParser) -> str:
    name = kread("General", "ColorScheme")
    if not name and parser.has_section("General"):
        name = parser.get("General", "colorscheme", fallback="")
    return name.strip()


def preset_look_and_feel(parser: configparser.ConfigParser, target_mode: str) -> str:
    """读取系统设置里预设的深色/浅色全局主题（Automatic Look and Feel 的配对）。

    对应 kdeglobals 的 [KDE] DefaultDarkLookAndFeel / DefaultLightLookAndFeel，
    即用户在系统设置中指定的那两个主题，不自行猜测、也不写死。
    """
    key = "defaultdarklookandfeel" if target_mode == "dark" else "defaultlightlookandfeel"
    if parser.has_section("KDE"):
        return parser.get("KDE", key, fallback="").strip()
    return ""


def config_mode(parser: configparser.ConfigParser) -> Optional[str]:
    """按配置文件判断当前明暗（配色方案名 → 全局主题名 → 调色板亮度）。

    这是「已经应用了什么主题」的权威来源：主题是脚本写进 kdeglobals 的，
    写完之后立刻可读；而门户值在切换刚发生时可能还停在上一代。
    """
    named = mode_from_name(current_color_scheme(parser))
    if named:
        return named
    named = mode_from_name(current_look_and_feel(parser))
    if named:
        return named
    return palette_mode(parser)


def detect_mode(parser: configparser.ConfigParser) -> str:
    # 状态显示以用户实际看到的明暗为准（门户优先），这样图标和屏幕状态一致。
    portal = portal_mode()
    if portal:
        return portal
    return config_mode(parser) or "light"


def available_look_and_feel() -> set[str]:
    """列出系统可用的全局主题 ID（含用户自建的中文主题）。"""
    names: set[str] = set()
    executable = shutil.which("plasma-apply-lookandfeel")
    if executable:
        for option in ("--list", "-l"):
            try:
                result = subprocess.run(
                    [executable, option],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=8,
                )
                lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
                if lines and not any("usage" in line.lower() or "用法" in line for line in lines):
                    names.update(lines)
                    break
            except (OSError, subprocess.SubprocessError):
                pass

    # 回退：直接扫描主题安装目录，兼容没有 --list 的旧版本。
    for base in data_dirs():
        directory = base / "plasma" / "look-and-feel"
        if not directory.is_dir():
            continue
        for path in directory.iterdir():
            if path.suffix == ".desktop":
                names.add(path.name)
            elif path.is_dir():
                metadata = path / "metadata.json"
                if metadata.is_file():
                    try:
                        data = json.loads(metadata.read_text(encoding="utf-8"))
                        names.add(data.get("KPlugin", {}).get("Id") or path.name)
                    except (OSError, ValueError):
                        names.add(path.name)
                else:
                    names.add(path.name)
    return names


def normalize(name: str) -> str:
    return re.sub(r"[^a-z0-9\u4e00-\u9fff]", "", name.lower())


def common_prefix_length(left: str, right: str) -> int:
    length = 0
    for a, b in zip(left, right):
        if a != b:
            break
        length += 1
    return length


def counterpart_theme(theme: str, available: set[str], target_mode: str) -> Tuple[Optional[str], str]:
    """在当前主题的基础上，找到明暗相反且系统中确实存在的主题 ID。

    返回 (主题 ID, 来源)：来源 derived 表示按名称推断，default 表示用了兜底默认主题。
    """
    if not available:
        theme_id = DEFAULT_DARK_THEME if target_mode == "dark" else DEFAULT_LIGHT_THEME
        return theme_id, "default"

    candidates: list[str] = []
    for source, destination in SWAP_PAIRS:
        if mode_from_name(source) == target_mode:
            continue
        if source in theme:
            candidates.append(theme.replace(source, destination))

    normalized = {normalize(name): name for name in available}
    for candidate in candidates:
        if candidate in available:
            return candidate, "derived"
        found = normalized.get(normalize(candidate))
        if found:
            return found, "derived"

    # 名称里没有明暗标记时（如 org.kde.breeze.desktop），按系列相似度挑选。
    base = theme
    for source, _ in SWAP_PAIRS:
        base = base.replace(source, "")
    base_normalized = normalize(base)
    scored: list[tuple[int, str]] = []
    for name in available:
        if mode_from_name(name) != target_mode:
            continue
        name_normalized = normalize(name)
        score = common_prefix_length(base_normalized, name_normalized)
        if base_normalized and (base_normalized in name_normalized or name_normalized in base_normalized):
            score += 1000
        scored.append((score, name))
    if scored:
        scored.sort(key=lambda item: (-item[0], item[1]))
        if scored[0][0] > 0 or not base_normalized:
            return scored[0][1], "derived"

    defaults = (
        (DEFAULT_DARK_THEME, DEFAULT_LIGHT_THEME)
        if target_mode == "dark"
        else (DEFAULT_LIGHT_THEME, DEFAULT_DARK_THEME)
    )
    for default in defaults:
        if default in available:
            return default, "default"
        found = normalized.get(normalize(default))
        if found:
            return found, "default"
    return None, "none"


def resolve_theme(parser: configparser.ConfigParser, target_mode: str) -> Tuple[Optional[str], str]:
    """解析目标主题，返回 (主题 ID, 来源)。

    来源 preset 表示命中了「系统设置 → 外观 → 全局主题」里预设的那一对，这是唯一
    完全符合预期的来源；derived / default 都是推测，需要提示用户去配置。
    """
    preset = preset_look_and_feel(parser, target_mode)
    if preset:
        return preset, "preset"
    return counterpart_theme(
        current_look_and_feel(parser),
        available_look_and_feel(),
        target_mode,
    )


def apply_look_and_feel(theme: str) -> str:
    """应用主题，返回实际使用的机制：lookandfeel 或 colorscheme。"""
    executable = shutil.which("plasma-apply-lookandfeel")
    if executable:
        # 本机版本只接受 --apply，位置参数会被当作帮助请求并静默成功。
        result = subprocess.run(
            [executable, "--apply", theme],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            detail = (result.stderr or result.stdout or "无错误输出").strip()
            raise RuntimeError(f"应用全局主题 {theme!r} 失败：{detail}")
        return "lookandfeel"

    # 没有全局主题工具时，退化为切换系统自带的 Breeze 配色。
    fallback = shutil.which("plasma-apply-colorscheme")
    if not fallback:
        raise RuntimeError("找不到 plasma-apply-lookandfeel / plasma-apply-colorscheme")
    scheme = FALLBACK_DARK_SCHEME if mode_from_name(theme) == "dark" else FALLBACK_LIGHT_SCHEME
    result = subprocess.run(
        [fallback, scheme],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "无错误输出").strip()
        raise RuntimeError(f"应用配色方案 {scheme!r} 失败：{detail}")
    return "colorscheme"


def gtk_dark_preference() -> Optional[bool]:
    """读取 GTK 侧的「偏好深色」开关，即 kde-gtk-config 同步的另一条通道。"""
    for directory in ("gtk-3.0", "gtk-4.0"):
        parser = load_config(f"{directory}/settings.ini")
        if not parser.has_section("Settings"):
            continue
        raw = parser.get("Settings", "gtk-application-prefer-dark-theme", fallback="").strip().lower()
        if raw in ("true", "1", "yes"):
            return True
        if raw in ("false", "0", "no"):
            return False
    return None


def settle_timeout() -> float:
    raw = os.environ.get("DARKLIGHT_SETTLE_TIMEOUT", "").strip()
    try:
        value = float(raw) if raw else DEFAULT_SETTLE_TIMEOUT
    except ValueError:
        value = DEFAULT_SETTLE_TIMEOUT
    return min(max(value, 0.0), 10.0)


def nudge_delay() -> float:
    raw = os.environ.get("DARKLIGHT_NUDGE_DELAY", "").strip()
    try:
        value = float(raw) if raw else DEFAULT_NUDGE_DELAY
    except ValueError:
        value = DEFAULT_NUDGE_DELAY
    return min(max(value, 0.0), 10.0)


def debug(message: str) -> None:
    if os.environ.get("DARKLIGHT_DEBUG"):
        print(f"darklight-toggle: {message}", file=sys.stderr)


def wait_for_settle(target_mode: str) -> bool:
    """等门户与 GTK 两条通道都更新到目标模式，返回是否在超时前对齐。

    KDE 一次切换要经过多条异步通道：门户的 color-scheme 几乎立刻更新，
    GTK 侧（kde-gtk-config）通常滞后 0.1～0.4 秒。补发的通知必须等全部对齐后再发，
    否则补出去的那一批仍携带过渡态。
    """
    portal_observable = portal_mode() is not None
    gtk_observable = gtk_dark_preference() is not None
    if not portal_observable and not gtk_observable:
        # 两条通道都读不到（无 D-Bus、无 GTK 配置）时无从等待，直接补发即可。
        return True

    want_dark = target_mode == "dark"
    deadline = time.monotonic() + settle_timeout()
    while True:
        portal_ok = not portal_observable or portal_mode() == target_mode
        gtk_ok = not gtk_observable or gtk_dark_preference() == want_dark
        if portal_ok and gtk_ok:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(SETTLE_POLL_INTERVAL)


def nudge_enabled(choice: Optional[str]) -> bool:
    raw = choice or os.environ.get("DARKLIGHT_NUDGE") or "always"
    return raw.strip().lower() not in ("never", "no", "false", "off", "0")


def nudge_theme(theme: str) -> None:
    """再应用一次同一全局主题，补发一批配置变更通知。

    背景：Chromium 系（Electron）应用在 KDE 上处理 color-scheme 通知时会错后一代，
    表现为「启动后第一次切换不生效、之后再切就是反相」。补发同一主题的通知可以让
    内核前进一代并与系统对齐；主题值不变，视觉上没有差异。
    """
    apply_look_and_feel(theme)


def announce_fallback(source: str, theme: str) -> None:
    """未命中预设时告知用户：本次用的是推测/兜底主题，并说明怎么改成预期配置。"""
    label = NOTICE_SOURCE_LABELS.get(source, "使用兜底")
    print(f"{NOTICE_PREFIX}，本次{label}：{theme}", file=sys.stderr)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="查询或切换 KDE Plasma 的浅色/深色模式")
    parser.add_argument("action", choices=("status", "toggle", "light", "dark"))
    parser.add_argument(
        "--nudge",
        choices=("always", "never"),
        default=None,
        help="切换后是否补发一次主题通知（默认 always，可用 DARKLIGHT_NUDGE=0 关闭）",
    )
    return parser


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        kdeglobals = load_config("kdeglobals")
        mode = detect_mode(kdeglobals)

        if args.action == "status":
            print(mode)
            return 0

        if args.action == "dark":
            target_mode = "dark"
        elif args.action == "light":
            target_mode = "light"
        else:
            # 切换方向以配置为准：门户值在切换刚结束的几百毫秒内可能是上一代，
            # 照它判方向会出现「点了没反应」（目标主题其实已在用）。
            current = config_mode(kdeglobals) or mode
            target_mode = "dark" if current == "light" else "light"

        # 优先使用系统设置里预设的深浅主题（DefaultDark/LightLookAndFeel）。
        theme, source = resolve_theme(kdeglobals, target_mode)
        if not theme:
            raise RuntimeError("找不到与当前主题配对的深色/浅色全局主题")
        if source != "preset":
            # 推测/兜底出来的配对可能不是用户想要的那一对，明确告知。
            announce_fallback(source, theme)
        method = apply_look_and_feel(theme)
        # 补发一次同值通知：修 Chromium/Electron 系应用「错后一代」的问题。
        # 仅全局主题机制才有效；配色方案回放不会产生新的配置变更通知。
        if method == "lookandfeel" and nudge_enabled(args.nudge):
            try:
                started = time.monotonic()
                settled = wait_for_settle(target_mode)
                debug(f"对齐耗时 {int((time.monotonic() - started) * 1000)}ms（超时={not settled}）")
                delay = nudge_delay()
                if delay > 0:
                    time.sleep(delay)
                nudge_theme(theme)
                debug(f"已补发通知，总耗时 {int((time.monotonic() - started) * 1000)}ms")
                if not settled:
                    print(
                        "darklight-toggle: 警告：GTK 侧未在超时内同步，已补发通知",
                        file=sys.stderr,
                    )
            except Exception as error:  # noqa: BLE001 - 主题已切换，补发失败只降级为警告
                print(
                    f"darklight-toggle: 警告：补发通知失败（主题已切换）：{error}",
                    file=sys.stderr,
                )
        print(target_mode)
        return 0
    except Exception as error:  # noqa: BLE001 - 统一转成命令行错误
        print(f"darklight-toggle: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
